{
  "name": "zonesteward-site",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --port 4321",
    "build": "astro build",
    "preview": "wrangler pages dev dist --d1 DB=zonesteward-globe",
    "db:local": "wrangler d1 execute zonesteward-globe --local --file=schema.sql",
    "db:remote": "wrangler d1 execute zonesteward-globe --remote --file=schema.sql",
    "test": "node tests/functions.test.mjs"
  },
  "dependencies": {
    "astro": "^5.14.1"
  },
  "devDependencies": {
    "wrangler": "^4.42.0"
  }
}
