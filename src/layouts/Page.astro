---
/* Inner-page layout: masthead, a header band, the page, footer, and the
   application modal so "Apply for beta" opens in place from every page. */
import Base from "./Base.astro";
import Masthead from "../components/Masthead.astro";
import SiteFooter from "../components/SiteFooter.astro";
import ApplyModal from "../components/ApplyModal.astro";
import "../styles/pages.css";

interface Props {
  title: string; description: string; eyebrow?: string; h1: string; lede?: string;
  wide?: boolean; jsonld?: Record<string, unknown>;
  crumbs?: [string, string][];   // [href, label] pairs, home first; the current page is not a link
  canonical?: string; robots?: string; type?: "website" | "article";
}
const { title, description, eyebrow, h1, lede, wide = false, jsonld, crumbs, canonical, robots, type } = Astro.props;
---
<Base title={title} description={description} canonical={canonical} robots={robots} type={type}>
  {jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />}
  <Masthead />
  <main>
    <header class="page-head">
      <div class="wrap">
        {crumbs && crumbs.length > 0 && (
          <nav class="crumbs" aria-label="Breadcrumb">
            {crumbs.map(([href, label], i) => <>{i > 0 && <span aria-hidden="true">›</span>}{href ? <a href={href}>{label}</a> : <b>{label}</b>}</>)}
          </nav>
        )}
        {eyebrow && <span class="sc">{eyebrow}</span>}
        <h1 style={eyebrow ? "margin-top:12px" : ""}>{h1}</h1>
        {lede && <p class="lede">{lede}</p>}
      </div>
    </header>
    <div class={wide ? "wide" : "prose"}>
      <slot />
    </div>
  </main>
  <SiteFooter />
  <ApplyModal />
  <script is:inline src="/g/apply.js"></script>
  <script is:inline src="/g/lightbox.js"></script>
</Base>
