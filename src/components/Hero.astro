---
/* Hero: the argument on the left, the product moving on the right — the
   live globe on real fleet traffic, cycling through its display modes.
   The video loops silently; under reduced motion only its poster shows. */
---
<section class="hero">
  <div class="wrap hero-split">
    <div class="hero-left">
      <div class="kicker">
        <i class="dot"></i>
        <span class="sc">For agencies running more zones than people</span>
      </div>
      <h1>A steward for your <i>Cloudflare fleet.</i></h1>
      <p class="lede">
        Forty zones, six clients, one support queue. Ask in plain language,
        approve the fix, read the audit. <b>Nothing writes without you.</b>
      </p>
      <div class="cta">
        <a href="/apply" class="btn btn-primary">Apply for beta</a>
        <a href="#gate" class="btn btn-ghost">How it works</a>
        <span class="cta-note">Runs on your own Cloudflare token and model key. We don’t sell tokens and don’t mark them up.</span>
        <span class="cta-note">Pre-launch private beta: free, unfinished, and built on your honest feedback. <a href="/beta">The trade →</a></span>
      </div>
    </div>
    <figure class="plate hero-plate">
      <div class="plate-in">
        <video class="hero-video" autoplay muted loop playsinline preload="metadata" width="1160" height="1032"
          poster="/media/globe-modes-poster.webp"
          aria-label="The live globe showing a fleet's request traffic as arcs to Cloudflare data centres, cycling through its display modes: Flow, Bundle, Heat, Trace, Pulse and Bars">
          <source src="/media/globe-modes.webm" type="video/webm" />
          <source src="/media/globe-modes.mp4" type="video/mp4" />
        </video>
      </div>
      <figcaption><span>The globe</span><span>Six ways to read the same traffic</span></figcaption>
    </figure>
  </div>
</section>
<script is:inline>
  (function () {
    var v = document.querySelector(".hero-video");
    if (!v || !window.matchMedia) return;
    var mq = window.matchMedia("(prefers-reduced-motion: reduce)");
    function apply() { if (mq.matches) { v.removeAttribute("autoplay"); v.pause(); } else if (v.paused) { v.play().catch(function () {}); } }
    apply();
    if (mq.addEventListener) mq.addEventListener("change", apply);
  })();
</script>
