---
/* bulk_apply (execute-core BULK_ALLOWED: purge_cache, create_waf_rule,
   block_ai_bots, create_cache_rule, create_rate_limit_rule; max 50 zones,
   ack above 10); zone groups; share links; fleet audit (FEATURES §7). */
const zones = ["client-a.com","client-b.com","client-c.co.uk","client-d.com","client-e.net","client-f.com","client-g.com","client-h.com","client-i.com","client-j.com","client-k.com","client-l.com"];
---
<section id="fleet">
  <div class="wrap">
    <div class="sec-head">
      <span class="sc">Fleet</span>
      <h2>Forty zones. One card.</h2>
      <p>
        Group zones by client. Then a cache purge, a WAF rule, a rate limit, a
        cache rule or an AI-scraper block goes to the whole group on one
        approval card, with a result per zone read back from Cloudflare — up to
        fifty at a time, and a separate acknowledgement once it touches more
        than ten. Give each client a share link scoped to their group and they
        see their sites, live, and nothing else.
      </p>
    </div>
    <div class="fleet-grid">
      <figure class="plate">
        <div class="plate-in bulk">
          <div class="rule-top"><span class="kick">Bulk apply · group “Retail clients” · 12 zones</span><span class="sev-tag" style="color:#ffb374;border-color:rgba(246,130,31,.45)">medium</span></div>
          <h3>Purge cache · <code>/</code></h3>
          <p class="rule-desc">Purge the homepage by URL on every zone in the group. Nothing else is touched.</p>
          <ul class="bz">
            {zones.map((z, i) => <li><span>{z}</span><b class={i === 4 ? "pending" : ""}>{i === 4 ? "read-back…" : "verified ✓"}</b></li>)}
          </ul>
          <div class="rule-foot">
            <label class="ack"><input type="checkbox" checked disabled /> I understand this touches 12 zones</label>
            <span class="sp"><span class="chip-btn">Reject</span><span class="chip-btn solid">Approved</span></span>
          </div>
        </div>
        <figcaption><span><b>Plate VII.</b> One change, twelve zones, twelve read-backs</span><span>Fleet</span></figcaption>
      </figure>
      <ol class="ladder">
        <li><div><b>Zone groups</b><p>Name a set of zones — a client, an environment, everything on Pro. Groups scope bulk changes and share links.</p></div></li>
        <li><div><b>Share links per client</b><p>No login. Their group only. Time-limited and revocable, never carrying more than the role of the person who made it.</p></div></li>
        <li><div><b>Fleet audit</b><p>Reconciles what the globe shows against what Cloudflare actually permits per zone, and flags every mismatch between view, data and token.</p></div></li>
        <li><div><b>Many tokens, many accounts</b><p>Connect a token per Cloudflare account. Where several reach one zone, the most capable is used and a 403 falls through to the next.</p></div></li>
      </ol>
    </div>
  </div>
</section>
