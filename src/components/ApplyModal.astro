---
/* Full-screen application. Every "Apply for beta" link on the page points at
   /apply, which is a real page; this script intercepts those clicks and opens
   the same form in a <dialog> instead. Native <dialog> gives us focus trapping,
   Escape, and the backdrop for free. Without JS the links simply navigate. */
import ApplyForm from "./ApplyForm.astro";
---
<dialog class="apply-dlg" id="apply-dlg" aria-labelledby="apply-dlg-title">
  <div class="apply-dlg-in">
    <aside class="apply-side">
      <a href="/" class="mark">Zone<i>steward</i></a>
      <span class="sc" style="margin-top:38px;display:block">Private beta · 20 seats</span>
      <h2 id="apply-dlg-title" style="margin-top:12px">Twenty seats.<br />Yours if it fits.</h2>
      <p class="lede" style="font-size:15.5px;margin-top:18px;max-width:38ch">
        Free for the whole beta, then half price for your first year. We're
        choosing for fit, not size — a small fleet with a real problem beats a
        big one without.
      </p>
      <ul class="fit">
        <li>You run zones for other people</li>
        <li>You'll give honest feedback</li>
        <li>You're comfortable being early</li>
      </ul>
    </aside>
    <div class="apply-main">
      <button type="button" class="apply-close" data-close aria-label="Close">×</button>
      <ApplyForm id="apply-modal" />
    </div>
  </div>
</dialog>

<script is:inline>
  (function () {
    var dlg = document.getElementById("apply-dlg");
    if (!dlg || typeof dlg.showModal !== "function") return;
    var isApplyHash = function () { return location.hash.indexOf("#apply") === 0; };

    function open(push) {
      if (dlg.open) return;
      if (push && !isApplyHash()) history.pushState({ apply: true }, "", location.pathname + location.search + "#apply/1");
      dlg.showModal();
      document.documentElement.classList.add("dlg-open");
      var first = dlg.querySelector("input:not([type=hidden]):not([tabindex='-1']):not([hidden] *)");
      if (first) setTimeout(function () { first.focus(); }, 30);
    }
    function close() {
      if (!dlg.open) return;
      // We pushed a history entry to open; going back is what closes it, so
      // the browser's Back button and our × do the same thing.
      if (history.state && history.state.apply) history.back();
      else dlg.close();
    }
    dlg.addEventListener("close", function () {
      document.documentElement.classList.remove("dlg-open");
      if (isApplyHash()) history.replaceState(null, "", location.pathname + location.search);
    });
    // Escape fires 'cancel' before 'close'; route it through our close so the
    // history entry goes too.
    dlg.addEventListener("cancel", function (e) { e.preventDefault(); close(); });

    document.querySelectorAll('a[href="/apply"], a[href="#apply"]').forEach(function (a) {
      a.addEventListener("click", function (e) { e.preventDefault(); open(true); });
    });
    dlg.querySelector("[data-close]").addEventListener("click", close);
    dlg.addEventListener("click", function (e) { if (e.target === dlg) close(); });

    addEventListener("popstate", function () {
      if (isApplyHash()) open(false);
      else if (dlg.open) dlg.close();
    });

    if (isApplyHash()) {
      history.replaceState({ apply: true }, "", location.href);
      open(false);
    }
  })();
</script>
