---
import { Picture } from "astro:assets";
import gateCard from "../assets/shots/gate-card.png";
const ladder = [
  { b: "Impact classified before you see it",
    p: "Low, medium or high, decided on the server. A lockdown or an apex DNS deletion needs an acknowledgement, not a click." },
  { b: "Blast radius against real traffic",
    p: "The rule is run against your last 24 hours before it exists — paths, networks, countries, user agents — so you see what it would have matched." },
  { b: "Read back from Cloudflare",
    p: "“Applied” means the server asked Cloudflare what the setting is now and got the answer it expected." },
  { b: "Reversible, with the payload stored",
    p: "Every change lands in the audit trail with the instructions to undo it. One click." },
];
---
<!-- The only dark band in the document. An earlier variant alternated all the
     way down the page and read as zebra stripes. -->
<section class="band" id="gate">
  <div class="band-head">
    <b>Plate II</b>
    <span>Proposed, approved, verified, revertable</span>
    <span class="r">client-a.com</span>
  </div>
  <div class="band-body">
    <div class="band-inner">
      <div>
        <figure class="plate gate-plate">
          <div class="plate-in">
            <Picture src={gateCard} formats={["avif", "webp"]} widths={[640, 960, 1440]} sizes="(min-width: 980px) 430px, 100vw" alt="Approval card: Create WAF rule (managed challenge) on WordPress login and XML-RPC endpoints — would have matched about 115 requests of the last 24 hours, broken down by path, network, country and user agent, with a map, and Approve & run or Reject" loading="lazy" decoding="async" />
          </div>
          <figcaption><span>Plate II</span><span>an approval card, as it appears</span></figcaption>
        </figure>
      </div>
      <div>
        <div class="sec-head" style="margin-bottom:30px">
          <span class="sc">The gate</span>
          <h2>Structurally unable to touch your zones.</h2>
          <p>
            Not a policy, not a system prompt. Every function that can change
            Cloudflare is reachable from the execution core alone, so a prompt
            injected through a request path or a user agent cannot cause a write.
          </p>
        </div>
        <ol class="ladder">
          {ladder.map((l) => <li><div><b>{l.b}</b><p>{l.p}</p></div></li>)}
        </ol>
      </div>
    </div>
  </div>
</section>
