---
/* From the read tools list_protections, list_edge, list_platform in
   app/api/chat/route.ts. Every item below is named in those descriptions. */
const groups = [
  ["Edge", ["Edge certificates and their expiry", "DNSSEC, down to the DS record", "Universal SSL", "Tiered Cache", "Cache Reserve", "Argo Smart Routing"]],
  ["Monitoring", ["Health checks and why they failed", "Load balancers with pool and origin health", "Logpush jobs, last push, errors", "Web Analytics (RUM) setup", "Cloudflare's own notification policies, and what they sent this week"]],
  ["Platform", ["Zone status, nameservers, zone hold", "Waiting rooms with live queue", "Observatory (Lighthouse) results", "Turnstile widgets", "Workers routes", "Access applications on the domain", "Email Routing rules", "Radar's view of this week's attacks"]],
];
---
<section class="knows" id="knows">
  <div class="wrap">
    <div class="sec-head">
      <span class="sc">Everything Cloudflare knows</span>
      <h2>Ask about anything on the zone. Not just traffic.</h2>
      <p>Most of this lives eleven clicks deep in the dashboard, one zone at a time. Here it's a sentence away, across all of them.</p>
    </div>
    <div class="knows-grid">
      {groups.map(([h, items]) => (
        <div class="kg"><h3>{h}</h3><ul>{items.map((t) => <li>{t}</li>)}</ul></div>
      ))}
    </div>
  </div>
</section>
