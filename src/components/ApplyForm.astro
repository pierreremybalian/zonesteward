---
/* The application itself. Rendered twice: inside the full-screen <dialog> on
   the home page, and as the standalone /apply page that the dialog falls back
   to without JavaScript. Three steps — who you are, what you run, whether it
   fits — driven by the script at the bottom; with JS off, all three simply
   show at once and the form posts natively. */
interface Props { id?: string; }
const { id = "apply" } = Astro.props;

const zones = [["1-10", "1–10"], ["11-25", "11–25"], ["26-100", "26–100"], ["100+", "100+"]];
const traffic = [
  ["<1M", "Under 1 million"], ["1-10M", "1–10 million"], ["10-100M", "10–100 million"],
  ["100M+", "100 million or more"], ["unsure", "Not sure"],
];
const plans = [["free", "Free"], ["pro", "Pro"], ["business", "Business"], ["enterprise", "Enterprise"]];
const focus = [
  ["security", "WAF, firewall, bots"], ["dns", "DNS"], ["performance", "Cache & performance"],
  ["investigation", "Analytics & incident digging"], ["reporting", "Client reporting"],
];
const roles = [
  ["me", "I do, on my own"], ["team", "A small team at my company"], ["ops", "A dedicated ops person"], ["client", "Each client manages their own"],
];
---
<form class="apply" id={id} method="POST" action="/api/beta" novalidate>
  <ol class="steps" aria-label="Progress">
    <li data-step-tab="1" aria-current="step"><span class="n">01</span>You</li>
    <li data-step-tab="2"><span class="n">02</span>Your fleet</li>
    <li data-step-tab="3"><span class="n">03</span>Fit</li>
  </ol>

  <!-- 01 · You -->
  <fieldset class="step" data-step="1">
    <legend class="step-title">Who should we write back to?</legend>
    <div class="f2">
      <p class="fld">
        <label for={`${id}-name`}>Name</label>
        <input id={`${id}-name`} name="name" type="text" required autocomplete="name" maxlength="120" />
      </p>
      <p class="fld">
        <label for={`${id}-email`}>Work email</label>
        <input id={`${id}-email`} name="email" type="email" required autocomplete="email" maxlength="200" />
      </p>
    </div>
    <div class="f2">
      <p class="fld">
        <label for={`${id}-company`}>Agency or company</label>
        <input id={`${id}-company`} name="company" type="text" autocomplete="organization" maxlength="160" />
      </p>
      <p class="fld">
        <label for={`${id}-site`}>Website <span class="opt">optional</span></label>
        <input id={`${id}-site`} name="site" type="text" inputmode="url" maxlength="200" placeholder="agency.com" />
      </p>
    </div>
  </fieldset>

  <!-- 02 · Your fleet -->
  <fieldset class="step" data-step="2" hidden>
    <legend class="step-title">The Cloudflare zones you manage.</legend>

    <div class="f2">
      <p class="fld">
        <label for={`${id}-zones`}>How many Cloudflare zones do you manage?</label>
        <select id={`${id}-zones`} name="zones" required>
          <option value="" selected disabled>Choose…</option>
          {zones.map(([v, l]) => <option value={v}>{l}</option>)}
        </select>
      </p>
      <p class="fld">
        <label for={`${id}-traffic`}>Monthly requests across those zones, roughly</label>
        <select id={`${id}-traffic`} name="traffic" required>
          <option value="" selected disabled>Choose…</option>
          {traffic.map(([v, l]) => <option value={v}>{l}</option>)}
        </select>
      </p>
    </div>

    <fieldset class="fld">
      <legend>Which Cloudflare plans are those zones on? <span class="opt">pick any</span></legend>
      <ul class="checks">
        {plans.map(([v, l]) => <li><label><input type="checkbox" name="plans" value={v} /><span>{l}</span></label></li>)}
      </ul>
      <span class="hint">Cloudflare exposes some analytics only on paid plans. The mix tells us what Zonesteward will be able to show you.</span>
    </fieldset>

    <fieldset class="fld">
      <legend>What takes most of your Cloudflare time? <span class="opt">pick any</span></legend>
      <ul class="checks">
        {focus.map(([v, l]) => <li><label><input type="checkbox" name="focus" value={v} /><span>{l}</span></label></li>)}
      </ul>
    </fieldset>

    <p class="fld">
      <label for={`${id}-role`}>Who manages those zones today?</label>
      <select id={`${id}-role`} name="role">
        <option value="">Choose…</option>
        {roles.map(([v, l]) => <option value={v}>{l}</option>)}
      </select>
    </p>
  </fieldset>

  <!-- 03 · Fit -->
  <fieldset class="step" data-step="3" hidden>
    <legend class="step-title">Is Zonesteward a fit?</legend>

    <p class="fld">
      <label for={`${id}-key`}>Do you have an Anthropic API key?</label>
      <select id={`${id}-key`} name="anthropic">
        <option value="yes">Yes</option>
        <option value="not yet">Not yet, but I can get one</option>
        <option value="what is that">No idea what that is</option>
      </select>
      <span class="hint">You bring your own key. It's stored encrypted, like your Cloudflare tokens, and used only to call Anthropic on your behalf — so Anthropic bills you directly at cost and we never mark it up.</span>
    </p>

    <p class="fld">
      <label for={`${id}-today`}>What goes wrong with how you manage Cloudflare today?</label>
      <textarea id={`${id}-today`} name="today" rows="5" maxlength="1200"
        placeholder="The thing you dread. Forty dashboard tabs. A WAF change on a client's live site at five o'clock with no way back. A client asking why their site is slow in Europe."></textarea>
    </p>

    <div class="consent">
      <span class="sc">The beta, in one paragraph</span>
      <p style="margin-top:8px">Zonesteward is pre-launch: free for the whole beta and half price for a year after, but unfinished and without an SLA. In return we ask everyone in your workspace who uses it three short questions a month, in the app, and you for two twenty-minute calls — around month one and month three. <a href="/beta" target="_blank" rel="noopener">The full trade →</a></p>
      <label><input type="checkbox" id={`${id}-agreed`} name="agreed" value="yes" required /><span>I've read what the beta involves and I'm in — the monthly questions, the two calls, and honest feedback along the way — and I agree to the <a href="/terms" target="_blank" rel="noopener">Terms of Use</a> and <a href="/privacy" target="_blank" rel="noopener">Privacy Policy</a> on behalf of my organisation.</span></label>
    </div>

    <!-- honeypot: invisible to people, irresistible to bots -->
    <p class="hp" aria-hidden="true">
      <label for={`${id}-curl`}>Company URL</label>
      <input id={`${id}-curl`} name="company_url" type="text" tabindex="-1" autocomplete="off" />
    </p>
  </fieldset>

  <div class="step-nav">
    <button type="button" class="btn btn-ghost" data-prev hidden>← Back</button>
    <span class="cta-note" data-note>Takes about two minutes.</span>
    <button type="button" class="btn btn-primary" data-next>Continue →</button>
    <button type="submit" class="btn btn-primary btn-lg" data-submit hidden>Apply for beta →</button>
  </div>
  <p class="apply-msg" role="status" aria-live="polite" hidden></p>
</form>
