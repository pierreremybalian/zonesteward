---
/* No seat counter here. There was a "5 OF 20 CLAIMED" indicator once, which
   was invented. The project's own rules say no invented metrics. */
---
<section class="beta" id="beta">
  <div class="wrap beta-in">
    <div>
      <span class="sc">Private beta</span>
      <h2 style="margin-top:14px">Twenty seats. Yours if it fits.</h2>
      <p class="lede" style="font-size:15.5px;margin-top:16px">
        Free for the whole beta, then half price for your first year, locked.
        Two minutes of questions about what you run and what goes wrong, and if
        it's a fit you get a workspace.
      </p>
    </div>
    <a href="/apply" class="btn btn-primary btn-lg">Apply for beta →</a>
  </div>
</section>
