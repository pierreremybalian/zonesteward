---
const nav = [
  { href: "/how-it-works", label: "How it works" },
  { href: "/use-cases", label: "Use cases" },
  { href: "/security", label: "Security" },
  { href: "/features", label: "Features" },
  { href: "/pricing", label: "Pricing" },
  { href: "/beta", label: "Beta" },
  { href: "/docs", label: "Docs" },
];
const APP = "https://app.zonesteward.com";
---
<header>
  <div class="wrap">
    <div class="masthead">
      <a href="/" class="mark">Zone<i>steward</i></a>
      <nav>{nav.map((n) => <a href={n.href}>{n.label}</a>)}</nav>
      <div class="end">
        <a href={APP} class="btn btn-ghost btn-sm" rel="nofollow">Sign in</a>
        <a href="/apply" class="btn btn-primary btn-sm">Apply for beta</a>
      </div>
    </div>
  </div>
</header>
