---
/* The stage: this site, seen through the product.
   The globe reads one zone — zonesteward.com — and nothing else. Not
   the client fleet. Visitors to this page are themselves that zone's traffic,
   so the globe fills up as people look at it.

   FALLBACK is baked in and rendered immediately; /api/globe replaces it when
   it answers. If the Function or D1 is down the globe still draws, which is
   the whole reason this is not an iframe of the operator. */
const FALLBACK = {
  MSP: 1.0, ORD: 0.72, LHR: 0.26, DFW: 0.41, IAD: 0.38, EWR: 0.33, LAX: 0.29,
  SEA: 0.22, FRA: 0.21, YYZ: 0.19, AMS: 0.17, SIN: 0.14, CDG: 0.12, NRT: 0.11,
  SYD: 0.09, GRU: 0.08, BOM: 0.07,
};
/* Beauharnois placeholder — replace with the real OVH region. */
const ORIGIN = { lat: 45.315, lng: -73.87, label: "ORIGIN" };
---
<section class="stage">
  <div class="wrap">
    <div class="stage-head">
      <span class="sc">Live</span>
      <span class="who">This page, right now, through Zonesteward</span>
      <span class="when"><i class="pulse"></i> <span id="when">updating…</span></span>
    </div>

    <canvas
      class="stage-globe"
      id="stage"
      aria-label="Globe showing the Cloudflare points of presence that served this site in the last 24 hours"
    ></canvas>
    <p class="stage-cap">
      <b id="cap">157 points of presence</b> · <span id="served">…</span>
    </p>

    <p class="frame-note">
      Bright points are the data centres that served this zone in the last 24 hours;
      the arcs are cache misses reaching the origin. The one that served you is lit.
    </p>
  </div>
</section>

<script is:inline src="/g/globe.js"></script>
<script is:inline src="/g/land.js"></script>
<script is:inline src="/g/globe-live.js"></script>
<script is:inline define:vars={{ FALLBACK, ORIGIN }}>
  (function () {
    const globe = liveGlobe(document.getElementById("stage"), {
      pops: POPS, land: LAND, live: FALLBACK, origin: ORIGIN,
    });
    document.getElementById("cap").textContent = POPS.length + " points of presence";

    function paint(live, updated) {
      const keys = Object.keys(live);
      if (!keys.length) return;
      globe.setLive(live);
      document.getElementById("served").textContent =
        keys.length + " served this zone in the last 24 hours";
      document.getElementById("when").textContent = updated;
    }

    paint(FALLBACK, "sample");

    fetch("/api/globe", { headers: { accept: "application/json" } })
      .then(function (r) { return r.ok ? r.json() : null; })
      .then(function (d) { if (d && d.colos) paint(d.colos, d.updated || "just now"); })
      .catch(function () { /* baked snapshot stands */ });
  })();
</script>
