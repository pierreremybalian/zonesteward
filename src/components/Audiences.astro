---
/* Who it's for: one page per role under /for, each with its own pains and
   the features that answer them. */
import { AUDIENCES } from "../data/audiences";
---
<section class="aud" aria-label="Who it is for">
  <div class="wrap">
    <span class="sc">Built for</span>
    <div class="aud-row">
      {AUDIENCES.map((a) => <a href={`/for/${a.slug}`}>{a.label}</a>)}
    </div>
    <p class="cta-note">Every role that touches a zone has its own page. Pick yours.</p>
  </div>
</section>
