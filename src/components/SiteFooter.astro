---
const links = [
  ["/how-it-works", "How it works"], ["/use-cases", "Use cases"], ["/security", "Security"], ["/features", "Features"],
  ["/pricing", "Pricing"], ["/docs", "Docs"], ["/blog", "Writing"], ["/about", "About"],
  ["/privacy", "Privacy"], ["/terms", "Terms"],
];
---
<footer>
  <div class="wrap">
    <div class="f-top">
      <a href="/" class="mark" style="font-size:19px">Zone<i>steward</i></a>
      <div class="f-links">{links.map(([h, l]) => <a href={h}>{l}</a>)}</div>
    </div>
    <p class="colophon">
      Built by one person who runs a fleet of Cloudflare zones for an agency,
      because the dashboard assumes you only have one. Set in Newsreader and
      Geist. Not affiliated with Cloudflare, Inc.
    </p>
  </div>
</footer>
