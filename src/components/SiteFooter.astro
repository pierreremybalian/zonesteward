    <div class="f-top">
      <a href="/" class="mark" style="font-size:19px">Zone<i>steward</i></a>
      <div class="f-links">{links.map(([h, l]) => <a href={h}>{l}</a>)}</div>
    </div>
    <p class="colophon">Not affiliated with Cloudflare, Inc.</p>
  </div>
</footer>
