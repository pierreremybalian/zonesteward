---
/* /apply/about-you, /apply/your-fleet, /apply/fit and /apply/received are the
   same page as /apply;
   the step is read from the path by apply.js, so a reload or a shared link
   lands on the right step. Clean paths, no hash. */
import Base from "../../layouts/Base.astro";
import ApplyForm from "../../components/ApplyForm.astro";
const STEPS: Record<string, string> = { "about-you": "About you", "your-fleet": "Your fleet", fit: "Is it a fit?", received: "Application received" };
// getStaticPaths runs in isolation: it cannot read STEPS above, so the list is repeated.
export function getStaticPaths() { return ["about-you", "your-fleet", "fit", "received"].map((step) => ({ params: { step } })); }
const { step } = Astro.params;
---
<Base
  title={`${STEPS[step!]} — Apply for the Zonesteward beta`}
  description="Twenty seats, free for the whole beta. Tell us what you run and what goes wrong with it."
  canonical="/apply"
  robots="noindex, follow"
>
  <div class="apply-page">
    <div class="apply-dlg-in">
      <aside class="apply-side">
        <a href="/" class="mark">Zone<i>steward</i></a>
        <span class="sc" style="margin-top:38px;display:block">Private beta · 20 seats</span>
        <h1 style="font-size:clamp(2rem,4vw,2.6rem);margin-top:12px">Twenty seats.<br />Yours if it fits.</h1>
        <p class="lede" style="font-size:15.5px;margin-top:18px;max-width:38ch">
          Free for the whole beta, then half price for your first year. We're
          choosing for fit, not size — a small fleet with a real problem beats a
          big one without.
        </p>
        <ul class="fit">
          <li>You run zones for other people</li>
          <li>You'll give honest feedback</li>
          <li>You're comfortable being early</li>
        </ul>
        <p style="margin-top:34px;font-size:13.5px"><a href="/" style="color:var(--accent)">← Back to the site</a></p>
      </aside>
      <div class="apply-main">
        <ApplyForm id="apply-page" />
      </div>
    </div>
  </div>
  <script is:inline src="/g/apply.js"></script>
</Base>
