---
import Base from "../layouts/Base.astro";
import Masthead from "../components/Masthead.astro";
import Hero from "../components/Hero.astro";
import Stage from "../components/Stage.astro";
import Problem from "../components/Problem.astro";
import AskIt from "../components/AskIt.astro";
import Gate from "../components/Gate.astro";
import Ask from "../components/Ask.astro";
import Alert from "../components/Alert.astro";
import Pricing from "../components/Pricing.astro";
import Beta from "../components/Beta.astro";
import SiteFooter from "../components/SiteFooter.astro";
import ApplyModal from "../components/ApplyModal.astro";

const jsonld = {
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "Organization", name: "Zonesteward", url: "https://zonesteward.com", logo: "https://zonesteward.com/og.jpg" },
    {
      "@type": "SoftwareApplication", name: "Zonesteward", applicationCategory: "DeveloperApplication",
      operatingSystem: "Web", url: "https://zonesteward.com",
      description: "Cloudflare fleet operations for agencies: ask in plain language, see every zone on one globe, approve changes that verify themselves.",
      offers: [
        { "@type": "Offer", name: "Studio", price: "49", priceCurrency: "USD", description: "Up to 25 zones, 3 members. From general availability." },
        { "@type": "Offer", name: "Agency", price: "149", priceCurrency: "USD", description: "Up to 100 zones, 10 members. From general availability." },
      ],
    },
  ],
};
---
<Base
  title="Zonesteward — A steward for your Cloudflare fleet"
  description="Ask your Cloudflare fleet a question in plain language. Approve the fix. Nothing writes without you."
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />
  <Masthead />
  <main>
    <Hero />
    <Stage />
    <Problem />
    <AskIt />
    <Gate />
    <Ask />
    <Alert />
    <Pricing />
    <Beta />
  </main>
  <SiteFooter />
  <ApplyModal />
  <script is:inline src="/g/apply.js"></script>
</Base>
