---
import Base from "../layouts/Base.astro";
import Masthead from "../components/Masthead.astro";
import Hero from "../components/Hero.astro";
import Stage from "../components/Stage.astro";
import Why from "../components/Why.astro";
import Audiences from "../components/Audiences.astro";
import Gate from "../components/Gate.astro";
import Tour from "../components/Tour.astro";
import Details from "../components/Details.astro";
import Pricing from "../components/Pricing.astro";
import Beta from "../components/Beta.astro";
import SiteFooter from "../components/SiteFooter.astro";
import ApplyModal from "../components/ApplyModal.astro";

const jsonld = {
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "Organization", name: "Zonesteward", url: "https://zonesteward.com", logo: "https://zonesteward.com/og.jpg" },
    {
      "@type": "SoftwareApplication", name: "Zonesteward", applicationCategory: "DeveloperApplication",
      operatingSystem: "Web", url: "https://zonesteward.com",
      description: "Cloudflare fleet operations for agencies: ask in plain language, approve changes that verify themselves, on your own keys with nothing marked up.",
      offers: [
        { "@type": "Offer", name: "Studio", price: "49", priceCurrency: "USD", description: "Up to 25 zones, 3 members. From general availability." },
        { "@type": "Offer", name: "Agency", price: "149", priceCurrency: "USD", description: "Up to 100 zones, 10 members. From general availability." },
      ],
    },
  ],
};
---
<Base
  title="Zonesteward — A steward for your Cloudflare fleet"
  description="Cloudflare for agencies running more zones than people. Ask in plain language, approve the fix, read the audit. Runs on your own Cloudflare token and model key — nothing marked up."
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />
  <Masthead />
  <main>
    <Hero />
    <Why />
    <Audiences />
    <Stage />
    <Gate />
    <Tour />
    <Details />
    <Pricing />
    <Beta />
  </main>
  <SiteFooter />
  <ApplyModal />
  <script is:inline src="/g/apply.js"></script>
  <script is:inline src="/g/lightbox.js"></script>
</Base>
