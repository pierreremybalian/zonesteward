---
import Base from "../layouts/Base.astro";
import Masthead from "../components/Masthead.astro";
import Hero from "../components/Hero.astro";
import Stage from "../components/Stage.astro";
import Problem from "../components/Problem.astro";
import Gate from "../components/Gate.astro";
import Ask from "../components/Ask.astro";
import Pricing from "../components/Pricing.astro";
import Beta from "../components/Beta.astro";
import SiteFooter from "../components/SiteFooter.astro";
---
<Base
  title="Zonesteward — A steward for your Cloudflare fleet"
  description="Ask your Cloudflare fleet a question in plain language. Approve the fix. Nothing writes without you."
>
  <Masthead />
  <main>
    <Hero />
    <Stage />
    <Problem />
    <Gate />
    <Ask />
    <Pricing />
    <Beta />
  </main>
  <SiteFooter />
</Base>
